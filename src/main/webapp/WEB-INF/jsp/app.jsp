<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Railway Ticket Demo</title>
  <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css">
</head>
<body>
<header class="top"><div class="wrap nav">
  <a class="brand" href="${pageContext.request.contextPath}/app/"><span class="brand-icon" aria-hidden="true">↗</span><span>Railway<span class="brand-accent">Demo</span><small>Journey planner</small></span></a>
  <nav aria-label="Main navigation">
    <a href="${pageContext.request.contextPath}/app/">Find trains</a>
    <c:choose><c:when test="${empty user}"><a href="${pageContext.request.contextPath}/app/login">Log in</a><a class="nav-cta" href="${pageContext.request.contextPath}/app/register">Create account</a></c:when>
    <c:otherwise><a href="${pageContext.request.contextPath}/app/bookings">My bookings</a><a href="${pageContext.request.contextPath}/app/complaints">Complaints</a><c:if test="${user.role == 'ADMIN'}"><a href="${pageContext.request.contextPath}/app/admin">Admin</a></c:if><form method="post" action="${pageContext.request.contextPath}/app/logout"><input type="hidden" name="csrf" value="${csrf}"><button type="submit">Log out</button></form></c:otherwise></c:choose>
  </nav>
</div></header>
<main class="wrap">
  <c:if test="${not empty error}"><div class="error" role="alert"><c:out value="${error}" /></div></c:if>
  <c:if test="${not empty sessionScope.flash}"><div class="success" role="status"><c:out value="${sessionScope.flash}" /></div><c:remove var="flash" scope="session" /></c:if>

  <c:if test="${page == '/' || page == '/search'}">
    <section class="hero">
      <div class="hero-copy"><span class="eyebrow">EXPLORE THE ROUTE</span><h1>Your next journey<br><em>starts here.</em></h1><p>Find a comfortable demo train, compare departure times, and book a seat in a few simple steps.</p><div class="hero-points"><span>8 demo trains</span><span>9 stations</span><span>14 days of runs</span></div></div>
      <div class="hero-art" aria-hidden="true"><div class="route-label">FEATURED CONNECTION</div><div class="route-line"><span class="route-dot"></span><span class="route-track"></span><span class="route-dot route-dot-end"></span></div><div class="hero-cities"><div><strong>New Delhi</strong><small>NDLS</small></div><div><strong>Bhubaneswar</strong><small>BBS</small></div></div><div class="art-footer">Discover routes across India <span>↗</span></div></div>
    </section>
    <section class="card search-card"><div class="section-heading"><div><span class="eyebrow dark">PLAN A TRIP</span><h2>Find your train</h2></div><p>Choose a route and travel date to see available departures.</p></div>
      <form method="get" action="${pageContext.request.contextPath}/app/search" class="search-grid">
        <label>From station<select name="origin" required><option value="">Choose departure</option><c:forEach items="${stations}" var="s"><option value="${s.id}" ${s.id == originId ? 'selected' : ''}><c:out value="${s.name}" /> (<c:out value="${s.code}" />)</option></c:forEach></select></label>
        <label>To station<select name="destination" required><option value="">Choose arrival</option><c:forEach items="${stations}" var="s"><option value="${s.id}" ${s.id == destinationId ? 'selected' : ''}><c:out value="${s.name}" /> (<c:out value="${s.code}" />)</option></c:forEach></select></label>
        <label>Travel date<input type="date" name="date" value="${travelDate}" min="${minTravelDate}" required></label>
        <button type="submit">Search trains <span aria-hidden="true">→</span></button>
      </form><p class="search-hint">Try New Delhi → Lucknow, New Delhi → Bhubaneswar, or Bhubaneswar → Howrah.</p>
    </section>
    <c:if test="${page == '/search'}"><section class="results"><div class="section-heading"><div><span class="eyebrow dark">YOUR OPTIONS</span><h2>Available trains</h2></div><p>Compare times, fares, and open seats.</p></div><c:choose><c:when test="${empty runs}"><div class="empty-state"><strong>No trains found for this route and date.</strong><p>Try another date or one of the suggested routes above.</p></div></c:when><c:otherwise>
      <div class="train-list"><c:forEach items="${runs}" var="r"><article class="card train-card"><div class="train-main"><div class="train-heading"><span class="train-icon" aria-hidden="true">▰</span><div><h3><c:out value="${r.trainName}" /></h3><small>Train <c:out value="${r.trainNumber}" /> · ${r.date}</small></div></div><div class="time-line"><div><strong><c:out value="${r.departure}" /></strong><span><c:out value="${r.origin}" /></span></div><div class="time-track"><span></span></div><div><strong><c:out value="${r.arrival}" /></strong><span><c:out value="${r.destination}" /></span></div></div></div><div class="train-side"><span class="seat-badge">${r.available} seats left</span><div class="fare"><small>Fare from</small><strong>₹${r.fare}</strong></div><c:choose><c:when test="${r.available > 0}"><a class="button" href="${pageContext.request.contextPath}/app/book?run=${r.id}&amp;origin=${originId}&amp;destination=${destinationId}">Book seat <span aria-hidden="true">→</span></a></c:when><c:otherwise><span class="muted">Sold out</span></c:otherwise></c:choose></div></article></c:forEach></div>
    </c:otherwise></c:choose></section></c:if>
  </c:if>

  <c:if test="${page == '/register'}"><section class="card narrow"><h1>Create account</h1><form method="post" action="${pageContext.request.contextPath}/app/register"><input type="hidden" name="csrf" value="${csrf}"><label>Name<input name="name" maxlength="100" required></label><label>Email<input type="email" name="email" maxlength="255" required></label><label>Password (12+ characters)<input type="password" name="password" minlength="12" maxlength="128" required></label><button>Create account</button></form></section></c:if>
  <c:if test="${page == '/login'}"><section class="card narrow"><span class="eyebrow dark">WELCOME BACK</span><h1>Log in</h1><p class="muted">Passenger and admin accounts use the same login page.</p><form method="post" action="${pageContext.request.contextPath}/app/login"><input type="hidden" name="csrf" value="${csrf}"><label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button>Log in</button></form><p class="form-note">New here? <a href="${pageContext.request.contextPath}/app/register">Create a passenger account</a>.</p></section></c:if>
  <c:if test="${page == '/book'}"><section class="card narrow"><h1>Book a seat</h1><h2><c:out value="${run.trainName}" /></h2><p><c:out value="${run.origin}" /> → <c:out value="${run.destination}" /> · ${run.date}</p><p>Fare: ₹${run.fare} · Seats left: ${run.available}</p><form method="post" action="${pageContext.request.contextPath}/app/book"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="run" value="${run.id}"><input type="hidden" name="origin" value="${originId}"><input type="hidden" name="destination" value="${destinationId}"><label>Passenger name<input name="passenger" maxlength="100" required></label><label>Age<input type="number" name="age" min="1" max="120" required></label><button>Confirm demo booking</button></form></section></c:if>
  <c:if test="${page == '/bookings'}"><section><h1>My bookings</h1><c:choose><c:when test="${empty bookings}"><p>You have no bookings yet. <a href="${pageContext.request.contextPath}/app/">Find a train</a>.</p></c:when><c:otherwise><div class="cards"><c:forEach items="${bookings}" var="b"><article class="card"><h2><c:out value="${b.trainName}" /></h2><p><strong>Demo PNR:</strong> <c:out value="${b.pnr}" /> · <c:out value="${b.status}" /></p><p>${b.date} · <c:out value="${b.origin}" /> → <c:out value="${b.destination}" /></p><p><c:out value="${b.passengerName}" />, age ${b.age} · Seat ${b.seat} · ₹${b.fare}</p><c:if test="${b.status == 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/app/cancel"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="booking" value="${b.id}"><button class="secondary" type="submit">Cancel booking</button></form></c:if></article></c:forEach></div></c:otherwise></c:choose></section></c:if>
  <c:if test="${page == '/complaints'}">
    <section class="card"><h1>Submit a complaint</h1><form method="post" action="${pageContext.request.contextPath}/app/complaints"><input type="hidden" name="csrf" value="${csrf}"><label>Category<select name="category" required><option value="BOOKING">Booking</option><option value="CANCELLATION">Cancellation</option><option value="SCHEDULE">Schedule</option><option value="OTHER">Other</option></select></label><label>Demo PNR (optional)<input name="pnr" maxlength="30"></label><label>Description<textarea name="description" maxlength="2000" rows="5" required></textarea></label><button>Submit complaint</button></form></section>
    <section><h2>My complaints</h2><c:choose><c:when test="${empty complaints}"><p>No complaints submitted.</p></c:when><c:otherwise><div class="cards"><c:forEach items="${complaints}" var="c"><article class="card"><strong>#${c.id} · <c:out value="${c.category}" /> · <c:out value="${c.status}" /></strong><p><c:out value="${c.description}" /></p><c:if test="${not empty c.pnr}"><p>Demo PNR: <c:out value="${c.pnr}" /></p></c:if><c:if test="${not empty c.response}"><p><strong>Admin response:</strong> <c:out value="${c.response}" /></p></c:if><small><c:out value="${c.createdAt}" /></small></article></c:forEach></div></c:otherwise></c:choose></section>
  </c:if>
  <c:if test="${page == '/admin'}">
    <section class="card"><h1>Admin: schedules</h1><p>Add or update a future dated run for an existing train.</p><form method="post" action="${pageContext.request.contextPath}/app/admin/run" class="grid"><input type="hidden" name="csrf" value="${csrf}"><label>Train<select name="number" required><c:forEach items="${trains}" var="t"><option value="${t[0]}"><c:out value="${t[0]}" /> — <c:out value="${t[1]}" /></option></c:forEach></select></label><label>Date<input type="date" name="date" required></label><label>Seats<input type="number" name="capacity" min="1" max="1000" required></label><label>Fare (₹)<input type="number" name="fare" min="0" step="0.01" required></label><button>Save run</button></form></section>
    <section class="card"><h2>Add a station</h2><form method="post" action="${pageContext.request.contextPath}/app/admin/station" class="grid"><input type="hidden" name="csrf" value="${csrf}"><label>Code<input name="code" maxlength="10" required></label><label>Name<input name="name" maxlength="100" required></label><label>City<input name="city" maxlength="100" required></label><button>Add station</button></form></section>
    <section class="card"><h2>Add a train</h2><form method="post" action="${pageContext.request.contextPath}/app/admin/train" class="grid"><input type="hidden" name="csrf" value="${csrf}"><label>Number<input name="number" maxlength="10" required></label><label>Name<input name="name" maxlength="100" required></label><button>Add train</button></form></section>
    <section class="card"><h2>Add or update a route stop</h2><p>Use increasing stop order. First stop needs departure; last stop needs arrival.</p><form method="post" action="${pageContext.request.contextPath}/app/admin/stop" class="grid"><input type="hidden" name="csrf" value="${csrf}"><label>Train<select name="number" required><c:forEach items="${trains}" var="t"><option value="${t[0]}"><c:out value="${t[0]}" /> — <c:out value="${t[1]}" /></option></c:forEach></select></label><label>Station<select name="station" required><c:forEach items="${stations}" var="s"><option value="${s.id}"><c:out value="${s.name}" /></option></c:forEach></select></label><label>Stop order<input type="number" name="order" min="1" required></label><label>Arrival<input type="time" name="arrival"></label><label>Departure<input type="time" name="departure"></label><label>Day offset<input type="number" name="dayOffset" min="0" max="7" value="0" required></label><button>Save stop</button></form></section>
    <section><h2>Recent bookings</h2><div class="cards"><c:forEach items="${bookings}" var="b"><article class="card"><strong><c:out value="${b.pnr}" /></strong> · <c:out value="${b.status}" /><p><c:out value="${b.trainName}" /> · ${b.date} · Seat ${b.seat}</p><p><c:out value="${b.passengerName}" /></p></article></c:forEach></div></section>
    <section><h2>Complaints</h2><div class="cards"><c:forEach items="${complaints}" var="c"><article class="card"><strong>#${c.id} · <c:out value="${c.category}" /></strong><p><c:out value="${c.description}" /></p><form method="post" action="${pageContext.request.contextPath}/app/admin/complaint"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="id" value="${c.id}"><label>Status<select name="status"><option value="OPEN" ${c.status == 'OPEN' ? 'selected' : ''}>Open</option><option value="IN_PROGRESS" ${c.status == 'IN_PROGRESS' ? 'selected' : ''}>In progress</option><option value="RESOLVED" ${c.status == 'RESOLVED' ? 'selected' : ''}>Resolved</option></select></label><label>Response<textarea name="response" maxlength="2000" rows="3" required><c:out value="${c.response}" /></textarea></label><button>Update complaint</button></form></article></c:forEach></div></section>
  </c:if>
  <div class="demo-note">Academic demonstration only. Bookings and PNRs are not valid Indian Railways tickets. No payment is collected.</div>
</main>
<footer class="wrap">Railway Ticket Demo · For learning only</footer>
</body></html>
